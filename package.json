{
  "name": "business-check",
  "version": "1.0.0",
  "description": "Is this business real? Paste a business's website and get plain-English red flags and good signs, using only free public information.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "business-check": "dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": { "node": ">=20" },
  "keywords": ["scam", "fraud", "osint", "phishing", "fake-store", "consumer-protection", "domain", "rdap", "investigation"],
  "author": "Matthew Porter (ThreatShield Alpha) <matt.porter@echo-trace.com>",
  "license": "MIT",
  "homepage": "https://threatshieldalpha.net/check/business",
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
